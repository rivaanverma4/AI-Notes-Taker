# Lecture Notes AI — all configuration is local. No API keys are required.

# Web app
HOST=127.0.0.1
PORT=3001

# Local data
DATA_DIR=./data

# Local speech-to-text (whisper.cpp)
# Run `npm run setup:whisper` to build the server and download the model.
WHISPER_BIN=./.tools/whisper.cpp/build/bin/whisper-server
WHISPER_MODEL=./models/ggml-large-v3-turbo-q8_0.bin
WHISPER_PORT=8081
# Use `en` for English or `auto` for multilingual detection.
WHISPER_LANGUAGE=en
WHISPER_THREADS=6

# Local AI note generation (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
# Fast model used while recording.
OLLAMA_LIVE_MODEL=qwen2.5:3b
# Best-quality model used for final notes. Falls back to the live model if absent.
# qwen2.5:3b is the default because it is dramatically faster on a 16 GB Mac and
# follows the transcript more faithfully. Set qwen2.5:7b for a slower extra pass.
OLLAMA_FINAL_MODEL=qwen2.5:3b

# Note generation cadence and limits
NOTES_INTERVAL_MS=60000
NOTES_MIN_CHARS=450
# Keep the context small by default; it is raised automatically for long lectures.
NOTES_NUM_CTX=8192
NOTES_MAX_NUM_CTX=32768
NOTES_NUM_PREDICT=4096
NOTES_LIVE_NUM_PREDICT=3000
NOTES_FINAL_NUM_PREDICT=5000
# Local generation timeouts. A stuck model must never freeze the app.
NOTES_LIVE_TIMEOUT_MS=120000
NOTES_FINAL_TIMEOUT_MS=240000
